<Window x:Class="Gizatullina_BPI_24_01_LR2.CalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результат расчёта ЛР2 В2"
        Width="850"
        Height="750"
        MinWidth="600"
        MinHeight="600"
        FontFamily="Unbounded"
        WindowStartupLocation="CenterOwner"
        Background="Violet">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Результат расчёта"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Исходные данные"
                           FontSize="19"
                           FontWeight="Bold"
                           VerticalAlignment="Top"/>

                <TextBlock x:Name="InputDataTextBlock"
                           Grid.Column="1"
                           FontSize="16"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="Формула"
                           FontSize="19"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Image x:Name="FormulaImage"
                       Height="110"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <TextBlock Text="Ход расчёта"
                               FontSize="19"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="CalculationTextBlock"
                               FontSize="15"
                               TextWrapping="Wrap"
                               LineHeight="28"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="ИТОГОВЫЙ РЕЗУЛЬТАТ"
                               FontSize="17"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"/>

                    <TextBlock x:Name="ResultTextBlock"
                               FontSize="27"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>

                </StackPanel>


                <Button Grid.Column="1"
                        Content="Закрыть"
                        Width="170"
                        Height="48"
                        FontSize="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>